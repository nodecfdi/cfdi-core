{
  "name": "@nodecfdi/cfdi-core",
  "description": "Librería que contiene las herramientas base para trabajar con CFDI's",
  "version": "1.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/src/types.js"
  },
  "imports": {
    "#src/*": "./src/*.js"
  },
  "scripts": {
    "prepare": "is-in-ci || husky",
    "changelog": "auto-changelog -u -p",
    "commitlint": "commitlint --edit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tool:code": "pnpm run lint:check && pnpm run typecheck",
    "tool:build": "pnpm run tool:code && pnpm run test:run",
    "build": "tsdown",
    "release": "release-it"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^22.15.32",
    "@vitest/coverage-istanbul": "^3.2.4",
    "auto-changelog": "^2.5.0",
    "husky": "^9.1.7",
    "is-in-ci": "^1.0.0",
    "jest-xml-matcher": "^1.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8"
  },
  "author": "Fernando Isidro <luffynando@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/nodecfdi/cfdi-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodecfdi/cfdi-core.git"
  },
  "bugs": {
    "url": "https://github.com/nodecfdi/cfdi-core/issues"
  },
  "keywords": [
    "cfdi",
    "cfdiutils",
    "elements",
    "xml",
    "dom",
    "structure",
    "node"
  ],
  "engines": {
    "node": "^22.13.0 || ^24 || ^26"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@12.21.0",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "auto-changelog": {
    "template": "keepachangelog",
    "hideCredit": true,
    "commitLimit": false
  }
}
